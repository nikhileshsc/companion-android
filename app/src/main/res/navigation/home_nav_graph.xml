<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.companion.astrodating.ui.home.ui.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">

    </fragment>
    <fragment
        android:id="@+id/messageFragment"
        android:name="com.companion.astrodating.ui.message.ui.MessageFragment"
        android:label="fragment_message"
        tools:layout="@layout/fragment_message" />
    <fragment
        android:id="@+id/topMatchesFragment"
        android:name="com.companion.astrodating.ui.topMatches.ui.TopMatchesFragment"
        android:label="fragment_top_matches"
        tools:layout="@layout/fragment_top_matches" />
    <fragment
        android:id="@+id/interestsFragment"
        android:name="com.companion.astrodating.ui.interests.ui.InterestsFragment"
        android:label="fragment_interests"
        tools:layout="@layout/fragment_interests" >
        <action
            android:id="@+id/action_interestsFragment_to_interestUserFragment"
            app:destination="@id/interestUserFragment"
            app:popUpTo="@id/interestsFragment"
            app:popUpToSaveState="true"/>
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.companion.astrodating.ui.profile.ui.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" />
    <fragment
        android:id="@+id/interestUserFragment"
        android:name="com.companion.astrodating.ui.interests.ui.InterestUserFragment"
        android:label="fragment_interest_user"
        tools:layout="@layout/fragment_interest_user" />
</navigation>