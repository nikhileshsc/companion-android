<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <TextView
            android:id="@+id/tvAttributeTitle1"
            style="@style/TableText"
            android:text="@string/text_ashtakoot_attr_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvDescriptionTitle1"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/viewAttribute1"
            style="@style/TableTitleView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvAttributeTitle1"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/tvDescriptionTitle1"
            style="@style/TableText"
            android:text="@string/text_ashtakoot_desc_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvUser1Title1"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvAttributeTitle1"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/viewDescription1"
            style="@style/TableTitleView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvDescriptionTitle1"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvUser1Title1"
            style="@style/TableText"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvUser2Title1"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvDescriptionTitle1"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/viewBlank1"
            style="@style/TableTitleView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvUser1Title1"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvUser2Title1"
            style="@style/TableText"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvMarksObtained1"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvUser1Title1"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/viewBlank2"
            style="@style/TableTitleView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvUser2Title1"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvMarksObtained1"
            style="@style/TableText"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvTotalTitle1"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvUser2Title1"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/viewBlank3"
            style="@style/TableTitleView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvMarksObtained1"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTotalTitle1"
            style="@style/TableText"
            android:layout_width="@dimen/_50sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvMarksObtained1"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorTableViewBg"
        app:layout_constraintTop_toBottomOf="@id/clLayout1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <TextView
            android:id="@+id/tvAttributeTitle2"
            style="@style/TableText"
            android:text="@string/text_ashtakoot_attr_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvDescriptionTitle2"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/viewAttribute2"
            style="@style/TableTitleView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvAttributeTitle2"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/tvDescriptionTitle2"
            style="@style/TableText"
            android:text="@string/text_ashtakoot_desc_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvUser1Title2"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvAttributeTitle2"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/viewDescription"
            style="@style/TableTitleView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvDescriptionTitle2"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvUser1Title2"
            style="@style/TableText"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvUser2Title2"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvDescriptionTitle2"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/viewBlank4"
            style="@style/TableTitleView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvUser1Title2"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvUser2Title2"
            style="@style/TableText"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvMarksObtained2"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvUser1Title2"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/viewBlank5"
            style="@style/TableTitleView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvUser2Title2"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvMarksObtained2"
            style="@style/TableText"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvTotalTitle2"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvUser2Title2"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/viewBlank6"
            style="@style/TableTitleView"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvMarksObtained2"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTotalTitle2"
            style="@style/TableText"
            android:layout_width="@dimen/_50sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvMarksObtained2"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>