<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMatchMakingReportBg"
    tools:context=".ui.completeanalysis.matchMakingReport.ui.MatchMakingReportActivity">

    <include
        android:id="@+id/layoutToolbar"
        layout="@layout/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_10sdp">


            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressIndicator"
                android:layout_width="@dimen/_200sdp"
                android:layout_height="@dimen/_200sdp"
                android:layout_margin="@dimen/_20sdp"
                android:max="36"
                app:indicatorColor="@color/colorPrimary"
                app:indicatorSize="@dimen/_140sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:trackColor="@color/white"
                app:trackCornerRadius="@dimen/_10sdp"
                app:trackThickness="@dimen/_10sdp" />

            <TextView
                android:id="@+id/tvProgress"
                style="@style/TextFontPoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23.6/36"
                android:textColor="@color/colorOtpText"
                android:textSize="@dimen/_20sdp"
                app:layout_constraintBottom_toBottomOf="@id/progressIndicator"
                app:layout_constraintEnd_toEndOf="@id/progressIndicator"
                app:layout_constraintStart_toStartOf="@id/progressIndicator"
                app:layout_constraintTop_toTopOf="@id/progressIndicator" />

            <TextView
                android:id="@+id/tvCompatibilityAnalysisTitle"
                style="@style/TextFontPoppinsSemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:text="@string/text_matchmakingreport_compatibilityscore_title"
                android:textColor="@color/black"
                android:textSize="@dimen/_14sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/progressIndicator" />

            <TextView
                android:id="@+id/tvCompatibilityAnalysisDesc"
                style="@style/TextFontPoppinsRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_matchmakingreport_compatibilityscore_desc"
                android:textColor="@color/colorTextBottomNav"
                android:textSize="@dimen/_11sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCompatibilityAnalysisTitle" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardAshtakoot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="@dimen/_6sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCompatibilityAnalysisDesc">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clAshtakoot"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_8sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/ivAshtakoot"
                            style="@style/ReportThumbImage"
                            android:src="@drawable/ic_complete_analysis_green_thumb"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/ivAshtakootInfo"
                            style="@style/ReportInfoImage"
                            android:src="@drawable/ic_purchaseplans_info"
                            app:layout_constraintBottom_toBottomOf="@id/ivAshtakoot"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/ivAshtakoot" />

                        <TextView
                            android:id="@+id/tvAshtakootTitle"
                            style="@style/ReportTitleText"
                            android:text="@string/text_matchmakingreport_ashtakoot_title"
                            app:layout_constraintBottom_toBottomOf="@id/ivAshtakoot"
                            app:layout_constraintEnd_toStartOf="@id/ivAshtakootInfo"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintStart_toEndOf="@id/ivAshtakoot"
                            app:layout_constraintTop_toTopOf="@id/ivAshtakoot"
                            app:layout_constraintVertical_bias="0.5" />

                        <TextView
                            android:id="@+id/tvAshtakootCount"
                            style="@style/ReportCountText"
                            android:text="(27.5 / 36)"
                            app:layout_constraintBottom_toBottomOf="@id/ivAshtakoot"
                            app:layout_constraintEnd_toStartOf="@id/ivAshtakootInfo"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintStart_toEndOf="@id/tvAshtakootTitle"
                            app:layout_constraintTop_toTopOf="@id/ivAshtakoot"
                            app:layout_constraintVertical_bias="0.5" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:id="@+id/viewAshtakoot"
                        style="@style/ReportView"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/clAshtakoot" />

                    <TextView
                        android:id="@+id/tvAshtakootDesc"
                        style="@style/ReportDescText"
                        android:text="@string/text_matchmakingreport_ashtakoot_desc"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/viewAshtakoot" />


                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardDashkoot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="@dimen/_6sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardAshtakoot">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clDashkoot"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_8sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/ivDashkoot"
                            style="@style/ReportThumbImage"
                            android:src="@drawable/ic_complete_analysis_green_thumb"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/ivDashkootInfo"
                            style="@style/ReportInfoImage"
                            android:src="@drawable/ic_purchaseplans_info"
                            app:layout_constraintBottom_toBottomOf="@id/ivDashkoot"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/ivDashkoot" />

                        <TextView
                            android:id="@+id/tvDashkootTitle"
                            style="@style/ReportTitleText"
                            android:text="@string/text_matchmakingreport_dashakoot_title"
                            app:layout_constraintBottom_toBottomOf="@id/ivDashkoot"
                            app:layout_constraintEnd_toStartOf="@id/ivDashkootInfo"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintStart_toEndOf="@id/ivDashkoot"
                            app:layout_constraintTop_toTopOf="@id/ivDashkoot"
                            app:layout_constraintVertical_bias="0.5" />

                        <TextView
                            android:id="@+id/tvDashkootCount"
                            style="@style/ReportCountText"
                            android:text="(27.5 / 36)"
                            app:layout_constraintBottom_toBottomOf="@id/ivDashkoot"
                            app:layout_constraintEnd_toStartOf="@id/ivDashkootInfo"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintStart_toEndOf="@id/tvDashkootTitle"
                            app:layout_constraintTop_toTopOf="@id/ivDashkoot"
                            app:layout_constraintVertical_bias="0.5" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:id="@+id/viewDashkoot"
                        style="@style/ReportView"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/clDashkoot" />

                    <TextView
                        android:id="@+id/tvDashkootDesc"
                        style="@style/ReportDescText"
                        android:text="@string/text_matchmakingreport_dashakoot_desc"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/viewDashkoot" />


                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardManglik"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_30sdp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="@dimen/_6sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardDashkoot">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clManglik"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_8sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/ivManglik"
                            style="@style/ReportThumbImage"
                            android:visibility="visible"
                            android:src="@drawable/ic_complete_analysis_green_thumb"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/ivManglikInfo"
                            style="@style/ReportInfoImage"
                            android:src="@drawable/ic_purchaseplans_info"
                            app:layout_constraintBottom_toBottomOf="@id/ivManglik"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/ivManglik" />

                        <TextView
                            android:id="@+id/tvManglikTitle"
                            style="@style/ReportTitleText"
                            android:text="@string/text_matchmakingreport_manglik_title"
                            app:layout_constraintBottom_toBottomOf="@id/ivManglik"
                            app:layout_constraintEnd_toStartOf="@id/ivManglikInfo"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintStart_toEndOf="@id/ivManglik"
                            app:layout_constraintTop_toTopOf="@id/ivManglik"
                            app:layout_constraintVertical_bias="0.5" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:id="@+id/viewManglik"
                        style="@style/ReportView"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/clManglik" />

                    <TextView
                        android:id="@+id/tvManglikDesc"
                        style="@style/ReportDescText"
                        android:text="@string/text_matchmakingreport_manglik_desc"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/viewManglik" />


                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.cardview.widget.CardView>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>