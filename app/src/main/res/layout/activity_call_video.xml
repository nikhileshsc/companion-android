<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootVideo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000"
    android:keepScreenOn="true"
    android:fitsSystemWindows="true"
    android:clickable="true">

    <!-- REMOTE video fills screen; other UI overlays on top -->
    <FrameLayout
        android:id="@+id/remoteContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="remoteVideo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Top gradient scrim for readability -->
    <View
        android:id="@+id/topScrim"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_top_fade"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Top info (peer name + state) -->
    <LinearLayout
        android:id="@+id/topInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="66dp"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/peerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Peer Name"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/callState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting…"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- OPTIONAL: Connection quality/timer row -->
<!--    <LinearLayout-->
<!--        android:id="@+id/qualityRow"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:orientation="horizontal"-->
<!--        android:gravity="center_vertical"-->
<!--        android:padding="8dp"-->
<!--        app:layout_constraintTop_toBottomOf="@id/topInfo"-->
<!--        app:layout_constraintStart_toStartOf="parent">-->

<!--        <ImageView-->
<!--            android:id="@+id/netQualityIcon"-->
<!--            android:layout_width="18dp"-->
<!--            android:layout_height="18dp"-->
<!--            android:src="@drawable/ic_network_quality"-->
<!--            android:contentDescription="network_quality"-->
<!--            app:tint="@android:color/white" />-->

<!--        <TextView-->
<!--            android:id="@+id/callTimer"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="00:00"-->
<!--            android:textColor="@android:color/white"-->
<!--            android:textSize="12sp"-->
<!--            android:layout_marginStart="8dp"/>-->
<!--    </LinearLayout>-->

    <!-- Bottom controls include -->
    <include
        android:id="@+id/controlsVideo"
        layout="@layout/layout_controls_video"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:elevation="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Bottom gradient scrim above controls for contrast -->
    <View
        android:id="@+id/bottomScrim"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_bottom_fade"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Local preview (PiP). Rounded, elevated, tappable -->
    <FrameLayout
        android:id="@+id/localContainer"
        android:layout_width="144dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_pip_rounded"
        android:clipToOutline="true"
        android:elevation="12dp"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintDimensionRatio="9:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controlsVideo"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintVertical_bias="0.95">

        <ImageView
            android:id="@+id/bgImageLocal"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"/>

        <!-- Optional mic/cam status chip over PiP -->
        <TextView
            android:id="@+id/pipStatusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_margin="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Mic off"
            android:textSize="11sp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_chip_dark"
            android:visibility="gone"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
