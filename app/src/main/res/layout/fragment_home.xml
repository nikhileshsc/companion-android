<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.home.ui.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingTop="@dimen/_16sdp"
        android:paddingBottom="@dimen/_8sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clSearchLayout"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_8sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar">

        <ImageView
            android:id="@+id/ivTitleLogo"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:background="@drawable/bg_label_white"
            android:padding="@dimen/_6sdp"
            android:src="@drawable/companion_login_logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextFontPoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_9sdp"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/colorTitle"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="@id/ivTitleLogo"
            app:layout_constraintStart_toEndOf="@id/ivTitleLogo"
            app:layout_constraintTop_toTopOf="@id/ivTitleLogo" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSearchView"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/colorHint"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnGlobe"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/quantum_grey300"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:closeIcon="@drawable/ic_home_search_cancel"
                app:queryHint=""
                app:searchIcon="@drawable/ic_home_search" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGlobe"
            app:cornerRadius="8dp"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:backgroundTint="@color/quantum_grey300"

            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_public"
            app:iconSize="40dp"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toBottomOf="@id/cardSearchView"
            app:layout_constraintEnd_toStartOf="@id/ivFilter"
            app:layout_constraintTop_toTopOf="@id/cardSearchView"
            app:iconTint="@null" />

<!--        <TextView-->
<!--            android:id="@+id/tvOnline"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginTop="@dimen/_4sdp"-->
<!--            android:background="@drawable/bg_label_white"-->
<!--            android:gravity="center"-->
<!--            android:paddingHorizontal="@dimen/_6sdp"-->
<!--            android:paddingVertical="@dimen/_2sdp"-->
<!--            android:text=" Online "-->
<!--            android:textColor="@color/black"-->
<!--            android:textSize="@dimen/_8sdp"-->
<!--            app:layout_constraintEnd_toEndOf="@id/btnGlobe"-->
<!--            app:layout_constraintStart_toStartOf="@id/btnGlobe"-->
<!--            app:layout_constraintTop_toBottomOf="@id/btnGlobe" />-->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ivFilter"
            app:cornerRadius="8dp"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:backgroundTint="@color/quantum_grey300"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            android:visibility="visible"
            app:icon="@drawable/ic_home_filter"
            app:iconSize="30dp"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toBottomOf="@id/btnGlobe"
            app:layout_constraintEnd_toStartOf="@id/ivNotification"
            app:layout_constraintTop_toTopOf="@id/btnGlobe"
            app:iconTint="@null" />

<!--        <TextView-->
<!--            android:id="@+id/tvFilter"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginTop="@dimen/_4sdp"-->
<!--            android:background="@drawable/bg_label_white"-->
<!--            android:gravity="center"-->
<!--            android:paddingHorizontal="@dimen/_6sdp"-->
<!--            android:paddingVertical="@dimen/_2sdp"-->
<!--            android:text="   Filter   "-->
<!--            android:textColor="@color/black"-->
<!--            android:textSize="@dimen/_8sdp"-->
<!--            app:layout_constraintEnd_toEndOf="@id/ivFilter"-->
<!--            app:layout_constraintStart_toStartOf="@id/ivFilter"-->
<!--            app:layout_constraintTop_toBottomOf="@id/ivFilter" />-->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ivNotification"
            app:cornerRadius="8dp"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:backgroundTint="@color/quantum_grey300"
            android:contentDescription="@string/text_notification_title"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_home_notification"
            app:iconSize="40dp"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toBottomOf="@id/cardSearchView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cardSearchView"
            app:iconTint="@null" />

<!--        <TextView-->
<!--            android:id="@+id/tvNotification"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginTop="@dimen/_4sdp"-->
<!--            android:background="@drawable/bg_label_white"-->
<!--            android:gravity="center"-->
