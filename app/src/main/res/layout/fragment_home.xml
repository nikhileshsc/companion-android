<!--            app:layout_constraintEnd_toEndOf="@id/ivNotification"-->
<!--            app:layout_constraintStart_toStartOf="@id/ivNotification"-->
<!--            app:layout_constraintTop_toBottomOf="@id/ivNotification" />-->

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clSearchLayout">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHomeUsers"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingHorizontal="@dimen/_8sdp"
            app:layout_constraintBottom_toTopOf="@id/cardTodaysHoroscope"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0"
            tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/row_item_home"
            tools:orientation="vertical"
            tools:scrollbars="vertical" />

        <!-- Today's Horoscope teaser -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTodaysHoroscope"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#F1EEFB"
            app:cardCornerRadius="@dimen/_12sdp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_12sdp">

                <ImageView
                    android:id="@+id/ivHoroscopeIcon"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:background="@drawable/bg_label_white"
                    android:padding="@dimen/_6sdp"
                    android:src="@drawable/ic_home_notification"
                    app:tint="#F5A623"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tvHoroscopeTitle"
                    style="@style/TextFontPoppinsBold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:text="Today's Horoscope"
                    android:textColor="#2B2050"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintEnd_toStartOf="@id/ivHoroscopeChevron"
                    app:layout_constraintStart_toEndOf="@id/ivHoroscopeIcon"
                    app:layout_constraintTop_toTopOf="@id/ivHoroscopeIcon" />

                <TextView
                    android:id="@+id/tvHoroscopeSubtitle"
                    style="@style/TextFontSofiaProRegular"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="See what the stars have in store for you today."
                    android:textColor="#6C6489"
                    android:textSize="@dimen/_9sdp"
                    app:layout_constraintEnd_toStartOf="@id/ivHoroscopeChevron"
                    app:layout_constraintStart_toEndOf="@id/ivHoroscopeIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvHoroscopeTitle" />

                <ImageView
                    android:id="@+id/ivHoroscopeChevron"
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:src="@drawable/ic_home_search_cancel"
                    app:tint="#6C6489"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvNoData"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:text="No Data Found"
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
