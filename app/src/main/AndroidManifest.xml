        <activity
            android:name=".ui.completeanalysis.dashgunaAnalysis.ui.DashgunaAnalysisActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.completeanalysis.ashtagunaAnalysis.ui.AshtakootAnalysisActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.completeanalysis.matchMakingReport.ui.MatchMakingReportActivity"
